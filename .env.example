# SalesPulse configuration (all optional; safe local defaults are used).
# Copy to .env only if you need to override the defaults.

SALESPULSE_DB_PATH=data/processed/salespulse.db
SALESPULSE_DATA_DIR=data
SALESPULSE_OUTPUT_DIR=output
SALESPULSE_SEED=42
# ISO date used as the "as of" ceiling for date validation. Defaults to today.
# SALESPULSE_AS_OF_DATE=2026-10-27
